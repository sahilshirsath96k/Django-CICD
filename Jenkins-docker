pipeline {
    agent {
        label 'ubuntu-agent'
    }

    stages {
        stage('Check Agent') {
            steps {
                sh 'whoami'
                sh 'docker --version'
                sh 'docker ps'
            }
        }
        stage('Build') {
            steps {
                echo "This is building the code"
                sh 'docker build -t notes-app:latest .'
            }
        }
    }
}
